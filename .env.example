# ElectroZone Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=7860
HOST=0.0.0.0

# Database Type Selection
DB_TYPE=mysql

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=electrozone

# Optional: Debug Mode
DEBUG=False

# Admin Credentials

ADMIN_PASSWORD=admin
ADMIN_NAME=admin